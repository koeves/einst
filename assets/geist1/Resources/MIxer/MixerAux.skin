    <CtrlPanel name="CtrlPanel" style="AuxChannelBackgroundOdd" rect="[x:0 y:0 w:193 h:161]" id="0">
        <CtrlPanel name="ClickPanel" style="EmptyPanelStyle" rect="[x:0 y:0 w:193 h:161]" id="0">
            <CtrlLabel name="NameLabel" style="StandardLabelCenteredStyle" rect="[x:2 y:18 w:189 h:10]" id="100011" text="Global aux" />
            <CtrlButton name="MuteButton" style="LEDMuteButtonStyle" rect="[x:17 y:30 w:19 h:17]" id="100019" displayName="Mute" text="M" />
            <CtrlButton name="SoloButton" style="LEDSoloButtonStyle" rect="[x:37 y:30 w:19 h:17]" id="100018" displayName="Solo" text="S" />
            <CtrlButtonGroup name="PrePostButton" rect="[x:64 y:30 w:120 h:17]" id="100000">
                <CtrlButton name="PreButton" style="RadioButtonLeftStyle" rect="[x:0 y:0 w:60 h:17]" id="100001" displayName="Pre fade" text="Pre" />
                <CtrlButton name="PostButton" style="RadioButtonRightStyle" rect="[x:58 y:0 w:60 h:17]" id="100002" displayName="Post fade" text="Post" />
