<root>
    <CtrlPanelStyle name="AuxChannelBackgroundOdd" imBackground="AuxBackgroundOdd.png" intSmartTileEdgeSize="5" intRoundedRectRadius="0" />
    <CtrlPanelStyle name="AuxChannelBackgroundEven" imBackground="AuxBackgroundEven.png" intSmartTileEdgeSize="5" intRoundedRectRadius="0" />
