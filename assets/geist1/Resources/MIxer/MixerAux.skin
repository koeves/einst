            <CtrlSlider name="GainSlider" style="SmallVerticalFaderStyle" rect="[x:89 y:63 w:15 h:75]" id="100012" displayName="Gain" />
            <CtrlLevelStrip name="VUMeterLeft" style="VU75Dark" rect="[x:106 y:63 w:4 h:75]" id="100000" />
            <CtrlLevelStrip name="VUMeterRight" style="VU75Dark" rect="[x:111 y:63 w:4 h:75]" id="100001" />
            <CtrlComboBox name="OutputCombo" style="LEDComboBoxStyle" rect="[x:59 y:140 w:75 h:17]" id="100010" />
        </CtrlPanel>
    </CtrlPanel>
</root>
