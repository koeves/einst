    <CtrlTableViewStyle name="GlobalTableStyle" optVSlider="true" optHeader="true" optAltRowColours="true" optColumnDividers="true" optRowDividers="true" colBorder="[r:18 g:25 b:60 a:255]" colFill="[r:0 g:0 b:0 a:0]" colSelect="[r:76 g:83 b:111 a:0]" colRow="[r:169 g:176 b:191 a:80]" colRowAlt="[r:199 g:206 b:217 a:40]" colHeaderBackground="[r:0 g:0 b:0 a:0]" colHeaderSelBackground="[r:148 g:155 b:172 a:175]" colHeaderText="[r:18 g:25 b:60 a:255]" colHeaderDivider="[r:18 g:25 b:60 a:255]" colColumnDivider="[r:18 g:25 b:60 a:255]" colColumnText="[r:18 g:25 b:60 a:255]">
