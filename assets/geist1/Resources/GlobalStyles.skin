	-->
	
	<!-- Default label, black text, left aligned -->
    <CtrlLabelStyle name="StandardLabelStyle" colText="[r:18 g:25 b:60 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlLabelStyle>  
	
	<!-- Default label, black text, centered -->
    <CtrlLabelStyle name="StandardLabelCenteredStyle" colText="[r:18 g:25 b:60 a:255]" centeredText="true">
