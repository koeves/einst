    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->

    <!-- Software Edit box (editable). Edit box of this type can be variety of sizes, the background image is tiled to match -> Suggest an image of 75px * 20px as a good start -->
    <CtrlTextBoxStyle name="LEDEditBoxStyle" imBackground="Images/EditBoxes/LEDEditBox.png" optSmartTile="true" optEditable="true" optSendValueWhenFocusLost="true" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle>
    <CtrlTextBoxStyle name="ModalEditBoxStyle" optEditable="true" optSendValueWhenFocusLost="true" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:243 g:243 b:243 a:255]" colText="[r:18 g:25 b:60 a:255]" colBorder="[r:18 g:25 b:60 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle>
    <CtrlTextBoxStyle name="ModalNonEditableEditBoxStyle" optEditable="false" optSendValueWhenFocusLost="true" optSingleClickEdit="false" optAlphaDisabled="true" colBackground="[r:243 g:243 b:243 a:255]" colText="[r:18 g:25 b:60 a:255]" colBorder="[r:18 g:25 b:60 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle>
    
    <CtrlTextBoxStyle name="LEDEditBoxCenteredStyle" imBackground="Images/EditBoxes/LEDEditBox.png" centeredText="true" optSmartTile="true" optEditable="true" optSendValueWhenFocusLost="true" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle>
    
    <!-- Software Edit box (non editable). Uses the same image as the style above... -->
    <CtrlTextBoxStyle name="LEDEditBoxNonEditableStyle" imBackground="Images/EditBoxes/LEDEditBox.png" optSmartTile="true" optEditable="false" optSendValueWhenFocusLost="false" optSingleClickEdit="false" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle>

    <!-- Software Combo box. Combo box of this type can be variety of sizes, the background image is tiled to match -> Suggest an image of 75px * 20px as a good start -->
    <CtrlTextBoxStyle name="LEDComboBoxStyle" imBackground="Images/EditBoxes/LEDComboBox.png" optSmartTile="false" centeredText="false" optEditable="false" dragable="false" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]" clippingRect="[x:2 y:0 w:61 h:17]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle> 
    <CtrlTextBoxStyle name="ModalComboBoxStyle" centeredText="false" optEditable="false"  optSmartTile="true" dragable="false" optSingleClickEdit="true" colBackground="[r:243 g:243 b:243 a:255]" colText="[r:18 g:25 b:60 a:255]" colBorder="[r:18 g:25 b:60 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle> 
    <CtrlTextBoxStyle name="LEDMediumComboBoxStyle" imBackground="Images/EditBoxes/LEDMediumComboBox.png" optSmartTile="false" centeredText="false" optEditable="false" dragable="false" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]" clippingRect="[x:0 y:0 w:52 h:17]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle> 
    <CtrlTextBoxStyle name="LEDLargeComboBoxStyle" imBackground="Images/EditBoxes/LEDLargeComboBox.png" optSmartTile="false" centeredText="false" optEditable="false" dragable="false" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]" clippingRect="[x:0 y:0 w:109 h:17]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle> 
    <CtrlTextBoxStyle name="LEDLargerComboBoxStyle" imBackground="Images/EditBoxes/LEDLargerComboBox.png" optSmartTile="false" centeredText="false" optEditable="false" dragable="false" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]" clippingRect="[x:2 y:0 w:82 h:17]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle> 
    
    <CtrlTextBoxStyle name="LEDSmallComboBoxStyle" imBackground="Images/EditBoxes/LEDSmallComboBox.png" optSmartTile="false" centeredText="false" optEditable="false" dragable="false" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]" clippingRect="[x:0 y:0 w:27 h:17]">
        <VFont name="font" vSize="12" fontName="Arial" />
