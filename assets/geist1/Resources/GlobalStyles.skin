	<VColour	name="SongPreviewingTrackColour" 	    red="200"		green="000"		blue="000"		alpha="100" />
    
	<!--
	SPLIT COLOURS
	These colours are used by the velocty split editor
	-->
	<VColour	name="SplitLineColour"			red="18"		green="25"		blue="60"		alpha="255"	/>
    <VColour	name="SplitGraphColour"			red="76"		green="83"		blue="111"		alpha="200"	/>
    <VColour	name="SplitMinMaxColour"		red="18"		green="25"		blue="60"		alpha="255"	/>
