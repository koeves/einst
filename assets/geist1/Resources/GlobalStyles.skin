    <CtrlButtonStyle name="x2ButtonStyle" imDown="Images/Buttons/LEDx2ButtonDown.png" imUp="Images/Buttons/LEDx2ButtonUp.png" imDisabled="Images/Buttons/LEDx2ButtonDisabled.png" optMomentary="true" optDrawText="false" colTextOn="[r:0 g:0 b:0 a:255]" colTextOff="[r:0 g:0 b:0 a:255]" />
    <CtrlButtonStyle name="Div2ButtonStyle" imDown="Images/Buttons/LEDDiv2ButtonDown.png" imUp="Images/Buttons/LEDDiv2ButtonUp.png" imDisabled="Images/Buttons/LEDDiv2ButtonDisabled.png" optMomentary="true" optDrawText="false" colTextOn="[r:0 g:0 b:0 a:255]" colTextOff="[r:0 g:0 b:0 a:255]" />

