    <!-- STYLES -->
    
    
    
    
    <!--
    BROWSER STYLES
    These styles are used by controls in the browser
    -->
    
    <CtrlButtonStyle name="BrowserHeaderViewOptionsButtonStyle" optMomentary="true" optDrawText="false" imDown="Browser/ViewOptionsButton.png" imUp="Browser/ViewOptionsButton.png">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>
    <CtrlButtonStyle name="BrowserParentNavigationButtonStyle" optMomentary="true" optSmartTile="true" optDrawText="true" imDown="Browser/ParentButtonTileDown.png" imUp="Browser/ParentButtonTileUp.png" colTextOff="[r:18 g:25 b:60 a:255]" colTextOn="[r:222 g:229 b:237 a:255]" colTextDisabled="[r:150 g:150 b:150 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>
    <CtrlTreeViewStyle name="BrowserTreeStyle" colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:255 g:255 b:255 a:0]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTreeViewStyle>
    <CtrlPanelStyle name="BrowserPanelStyle" colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:255 g:255 b:255 a:0]" noDefaultDrawing="true" />

    <!-- 
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // GLOBAL STYLES
    // These styles are used globally through out Guru2.
	// DO NOT ALTER THE "EMPTY PANEL STYLE!" 
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->

    <CtrlPanelStyle name="EmptyPanelStyle" colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:255 g:255 b:255 a:0]"   intSmartTileEdgeSize="5" intRoundedRectRadius="0" noDefaultDrawing="true" />
    <CtrlPanelStyle name="ModalPanelStyle" colBorder="[r:18 g:25 b:60 a:0]" colFill="[r:237 g:237 b:237 a:255]" intSmartTileEdgeSize="5" intRoundedRectRadius="0" noDefaultDrawing="false" />
    <CtrlPanelStyle name="BluePanelStyle"  colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:112 g:139 b:161 a:255]" intSmartTileEdgeSize="5" intRoundedRectRadius="0" noDefaultDrawing="false" />
    <CtrlPanelStyle name="FXGlobalBackgroundPanelStyle" imBackground="Effects/FXGlobalBackground.png"  colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:255 g:255 b:255 a:0]"   intSmartTileEdgeSize="5" intRoundedRectRadius="0" noDefaultDrawing="true" />
    <CtrlPanelStyle name="ModalPanelCollectionStyle" colBorder="[r:137 g:137 b:137 a:255]" colFill="[r:229 g:229 b:229 a:255]" intSmartTileEdgeSize="5" intRoundedRectRadius="5" />
    <CtrlPanelStyle name="ModalPanelTitleStyle" colBorder="[r:150 g:150 b:150 a:255]" colFill="[r:150 g:150 b:150 a:255]" intSmartTileEdgeSize="5" intRoundedRectRadius="0" />
    <CtrlPanelStyle name="ModalPanelBackgroundStyle" colBorder="[r:150 g:150 b:150 a:255]" colFill="[r:150 g:150 b:150 a:255]" intSmartTileEdgeSize="5" intRoundedRectRadius="5" noDefaultDrawing="false" />

     <!-- 
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // KNOB STYLES
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->

    <!-- Hardware small knob going from 0 - 100%. Knobs of this size should be 20px * 20px, in a film strip with 128 stages -->
    <CtrlKnobStyle name="HardKnobSmallLR" optStripInverted="false" imKnobNormal="Images/Knobs/HARDKnobSmallLR.png" optShiftFineBehaviour="true" optXFineBehaviour="false" macroValueScaler="100" microValueScaler="1000" longDim="26"/>
    
    <!-- Hardware large knob going from 0 - 100%. Knobs of this size should be 50px * 50px, in a film strip with 128 stages -->
    <CtrlKnobStyle name="HardKnobLargeLR" optStripInverted="false" imKnobNormal="Images/Knobs/HARDKnobLargeLR.png" optShiftFineBehaviour="true" optXFineBehaviour="false" macroValueScaler="100" microValueScaler="1000" longDim="75" />
    
    <!-- Hardware large knob going from -100% to +100%. Knobs of this size should be 50px * 50px, in a film strip with 128 stages -->
    <CtrlKnobStyle name="HardKnobLargeC" optStripInverted="false" imKnobNormal="Images/Knobs/HARDKnobLargeC.png" optShiftFineBehaviour="true" optXFineBehaviour="false" macroValueScaler="100" microValueScaler="1000" longDim="75" />

    <!-- Software small knob going from 0 - 100%. Knobs of this size should be 20px * 20px, in a film strip with 128 stages -->
    <CtrlKnobStyle name="LEDKnobMicroLR" optStripInverted="false" imKnobNormal="Images/Knobs/LEDKnobMicroLR.png" optShiftFineBehaviour="true" optXFineBehaviour="false" macroValueScaler="100" microValueScaler="1000" longDim="17" />

    <!-- Software small knob going from 0 - 100%. Knobs of this size should be 20px * 20px, in a film strip with 128 stages -->
    <CtrlKnobStyle name="LEDKnobSmallLR" optStripInverted="false" imKnobNormal="Images/Knobs/LEDKnobSmallLR.png" optShiftFineBehaviour="true" optXFineBehaviour="false" macroValueScaler="100" microValueScaler="1000" longDim="26" />
    
    <!-- Software large knob going from 0 - 100%. Knobs of this size should be 50px * 50px, in a film strip with 128 stages -->
    <CtrlKnobStyle name="LEDKnobLargeLR" optStripInverted="false" imKnobNormal="Images/Knobs/LEDKnobLargeLR.png" optShiftFineBehaviour="true" optXFineBehaviour="false" macroValueScaler="100" microValueScaler="1000" longDim="46" />
    
    <!-- Software large knob going from -100% to +100%. Knobs of this size should be 50px * 50px, in a film strip with 128 stages -->
    <CtrlKnobStyle name="LEDKnobLargeC" optStripInverted="false" imKnobNormal="Images/Knobs/LEDKnobLargeC.png" optShiftFineBehaviour="true" optXFineBehaviour="false" macroValueScaler="100" microValueScaler="1000" longDim="46" />
    
    <!-- Spinner style 20px * 20px, in a film strip with 128 stages (the spinner is a progress bar to show indeterminate ends -->
    <CtrlKnobStyle name="SpinnerStyle" imKnobNormal="Images/Knobs/LEDSpinner.png" />
    
    <!-- Spinner style 50px * 50px, in a film strip with 128 stages (the spinner is a progress bar to show indeterminate ends -->
    <CtrlKnobStyle name="LargeSpinnerStyle" imKnobNormal="Images/Knobs/LEDSpinnerLarge.png" />

    <!--
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // DEFAULT (NON GENERIC) BUTTONS
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->
  
  	<!-- Zoom in and zoom out buttons are 12px * 12px -->
    <CtrlButtonStyle name="ZoomInButtonStyle" optMomentary="true" optDrawText="false" imDown="Images/Buttons/LEDZoomInDown.png" imUp="Images/Buttons/LEDZoomInUp.png" imDisabled="Images/Buttons/LEDZoomInDisabled.png" />
    <CtrlButtonStyle name="ZoomOutButtonStyle" optMomentary="true" optDrawText="false" imDown="Images/Buttons/LEDZoomOutDown.png" imUp="Images/Buttons/LEDZoomOutUp.png" imDisabled="Images/Buttons/LEDZoomOutDisabled.png" />
        
    <CtrlButtonStyle name="LinkSmallButtonStyle" optMomentary="false" optDrawText="true" imDown="Images/Buttons/LEDLinkButtonDown.png" imUp="Images/Buttons/LEDLinkButtonUp.png" imDisabled="Images/Buttons/LEDLinkButtonDisabled.png" />
    <CtrlButtonStyle name="LinkLargeButtonStyle" optMomentary="false" optDrawText="true" imDown="Mixer/LinkButtonDown.png" imUp="Mixer/LinkButtonUp.png" imDisabled="Mixer/LinkButtonDisabled.png" />
    
    <CtrlButtonStyle name="ZoomOffButtonStyle" optMomentary="false" optDrawText="false" imDown="Images/Buttons/LEDNoZoomDown.png" imUp="Images/Buttons/LEDNoZoomUp.png" />
    <CtrlButtonStyle name="ZoomStartEndButtonStyle" optMomentary="false" optDrawText="false" imDown="Images/Buttons/LEDZoomStartEndDown.png" imUp="Images/Buttons/LEDZoomStartEndUp.png" />
    <CtrlButtonStyle name="ZoomStartButtonStyle" optMomentary="false" optDrawText="false" imDown="Images/Buttons/LEDZoomStartDown.png" imUp="Images/Buttons/LEDZoomStartUp.png" />
    <CtrlButtonStyle name="ZoomEndButtonStyle" optMomentary="false" optDrawText="false" imDown="Images/Buttons/LEDZoomEndDown.png" imUp="Images/Buttons/LEDZoomEndUp.png" />

    <!-- Standard mute / solo buttons. Button of this type should be 20px * 20px -->
    <CtrlButtonStyle name="LEDMuteButtonStyle" imDown="Images/Buttons/LEDMuteButtonDown.png" imUp="Images/Buttons/LEDMuteButtonUp.png" imDisabled="Images/Buttons/LEDMuteButtonDisabled.png" optMomentary="false" optDrawText="false" colTextOn="[r:210 g:217 b:227 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" />
    <CtrlButtonStyle name="LEDSoloButtonStyle" imDown="Images/Buttons/LEDSoloButtonDown.png" imUp="Images/Buttons/LEDSoloButtonUp.png" imDisabled="Images/Buttons/LEDSoloButtonDisabled.png" optMomentary="false" optDrawText="false" colTextOn="[r:210 g:217 b:227 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" />
