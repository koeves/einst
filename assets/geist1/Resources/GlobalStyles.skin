    -->

    
    <!-- Pan slider standard 46px * 12px -->
    <CtrlPanSliderStyle name="SmallPanStyle" noDefaultDrawing="true" imKnobOff="Images/Pan/LEDSmallPanKnob.png" imKnobOn="Images/Pan/LEDSmallPanKnob.png" imBackingStrip="Images/Pan/LEDSmallPanBase.png" imAltBackingStrip="Images/Pan/LEDSmallPanBaseAlt.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" faderHeadSize="10" optNoClickOutsideKnobMove="true" optNoClickOutsideKnobPage="true"/>
    <CtrlPanSliderStyle name="LargePanStyle" noDefaultDrawing="true" imKnobOff="Images/Pan/LEDSmallPanKnob.png" imKnobOn="Images/Pan/LEDSmallPanKnob.png" imBackingStrip="Images/Pan/LEDLargePanBase.png" imAltBackingStrip="Images/Pan/LEDLargePanBaseAlt.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" faderHeadSize="10" optNoClickOutsideKnobMove="true" optNoClickOutsideKnobPage="true" />
    <CtrlPanSliderStyle name="FatPanStyle" noDefaultDrawing="true" imKnobOff="Images/Pan/LEDFatPanKnob.png" imKnobOn="Images/Pan/LEDFatPanKnob.png" imBackingStrip="Images/Pan/LEDFatPanBase.png" imAltBackingStrip="Images/Pan/LEDFatPanBaseAlt.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" faderHeadSize="10" optNoClickOutsideKnobMove="true" optNoClickOutsideKnobPage="true" />

