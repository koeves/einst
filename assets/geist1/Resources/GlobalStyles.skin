    <CtrlButtonStyle name="StandardSubtractButtonStyle" imDown="Images/Buttons/LEDSubtractButtonDown.png" imUp="Images/Buttons/LEDSubtractButtonUp.png" imDisabled="Images/Buttons/LEDSubtractButtonDisabled.png" optMomentary="true" optDrawText="false" colTextOn="[r:0 g:0 b:0 a:255]" colTextOff="[r:0 g:0 b:0 a:255]" />
