    <CtrlTextBoxStyle name="HardDragableCenteredValueBoxStyle" imBackground="Images/EditBoxes/LEDValueBox.png" optSmartTile="true" centeredText="true" optEditable="true" dragable="true" optSingleClickEdit="false" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
