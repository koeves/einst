    -->
    
    <!-- Micro indicator style. Indicator of this type should be 15px * 15px -->
    <CtrlIndicatorStyle name="StandardMicroIndicatorStyle" imOff="Images/Indicators/LEDMicroIndicatorUp.png" imOn="Images/Indicators/LEDMicroIndicatorDown.png" />
   	<CtrlImageViewStyle name="EmptyImageStyle" optBorder="false" optBackground="false" />

    <!-- 
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // GENERIC BUTTONS (WE PUT THE TEXT ON THESE!)
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->

    <!-- Menu buttons style. Button of this type should be 50px * 20px - They are used to popup a menu -->
    <CtrlButtonStyle name="LEDMenuButtonStyle" imDown="Images/Buttons/LEDMenuButtonDown.png" imUp="Images/Buttons/LEDMenuButtonUp.png" imDisabled="Images/Buttons/LEDMenuButtonDisabled.png" optMomentary="true" optDrawText="true" textOffset="7" optTextLeftJustify="true" colTextOn="[r:222 g:229 b:237 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" colTextDisabled="[r:150 g:150 b:150 a:255]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>
    <CtrlButtonStyle name="LEDLargeMenuButtonStyle" imDown="Images/Buttons/LEDLargeMenuButtonDown.png" imUp="Images/Buttons/LEDLargeMenuButtonUp.png" imDisabled="Images/Buttons/LEDLargeMenuButtonDisabled.png" optMomentary="true" optDrawText="true" textOffset="7" optTextLeftJustify="true" colTextOn="[r:222 g:229 b:237 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" colTextDisabled="[r:150 g:150 b:150 a:255]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>
    <CtrlButtonStyle name="LEDUltraMenuButtonStyle" imDown="Images/Buttons/LEDUltraMenuButtonDown.png" imUp="Images/Buttons/LEDUltraMenuButtonUp.png" imDisabled="Images/Buttons/LEDUltraMenuButtonDisabled.png" optMomentary="true" optDrawText="true" textOffset="7" optTextLeftJustify="true" colTextOn="[r:222 g:229 b:237 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" colTextDisabled="[r:150 g:150 b:150 a:255]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>

    <!-- Momentary buttons style. Button of this type should be 50px * 20px -->
    <CtrlButtonStyle name="LEDMomentaryButtonStyle" imDown="Images/Buttons/LEDStandardButtonDown.png" imUp="Images/Buttons/LEDStandardButtonUp.png" imDisabled="Images/Buttons/LEDStandardButtonDisabled.png" optMomentary="true" optDrawText="true" colTextOn="[r:222 g:229 b:237 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" colTextDisabled="[r:150 g:150 b:150 a:255]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>
    
    
    <CtrlButtonStyle name="ModalMomentaryButtonStyle" optMomentary="true" optDrawText="true" colFillOff="[r:229 g:229 b:229 a:255]" colFillOn="[r:189 g:196 b:205 a:255]" colBorder="[r:18 g:25 b:60 a:255]" colTextOn="[r:18 g:25 b:60 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" colTextDisabled="[r:150 g:150 b:150 a:255]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>

    <!-- Latching buttons style. Button of this type should be 50px * 20px -->
    <CtrlButtonStyle name="ModalLatchingButtonStyle" optMomentary="false" optDrawText="true" colFillOff="[r:229 g:229 b:229 a:255]" colFillOn="[r:189 g:196 b:205 a:255]" colBorder="[r:18 g:25 b:60 a:255]" colTextOn="[r:18 g:25 b:60 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" colTextDisabled="[r:150 g:150 b:150 a:255]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>
    
    <!-- Latching buttons style. Button of this type should be 50px * 20px -->
    <CtrlButtonStyle name="LEDLatchingButtonStyle" imDown="Images/Buttons/LEDStandardButtonDown.png" imUp="Images/Buttons/LEDStandardButtonUp.png" imDisabled="Images/Buttons/LEDStandardButtonDisabled.png" optMomentary="false" optDrawText="true"  colTextOn="[r:222 g:229 b:237 a:255]" colTextOff="[r:18 g:25 b:60 a:255]" >
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>

    <!-- Small Momentary buttons style. Button of this type should be 20px * 20px -->
    <CtrlButtonStyle name="LEDSmallMomentaryButtonStyle" imDown="Images/Buttons/LEDSmallButtonDown.png" imUp="Images/Buttons/LEDSmallButtonUp.png" imDisabled="Images/Buttons/LEDSmallButtonDisabled.png" optMomentary="true" optDrawText="true" colTextOn="[r:0 g:0 b:0 a:255]" colTextOff="[r:0 g:0 b:0 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>
    
    <!-- Latching buttons style. Button of this type should be 20px * 20px -->
    <CtrlButtonStyle name="LEDSmallLatchingButtonStyle" imDown="Images/Buttons/LEDSmallButtonDown.png" imUp="Images/Buttons/LEDSmallButtonUp.png" imDisabled="Images/Buttons/LEDSmallButtonDisabled.png" optMomentary="false" optDrawText="true" colTextOn="[r:0 g:0 b:0 a:255]" colTextOff="[r:0 g:0 b:0 a:255]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlButtonStyle>
    
    <!-- MIX Style radio buttons -->
    
    
    
    <!-- Thin LED buttons, 24px * 20px -->
    <CtrlButtonStyle name="LEDMixButton" imDown="Mixer/LEDMixButtonDown.png" imUp="Mixer/LEDMixButtonUp.png" optMomentary="false" optDrawText="false" />
    <CtrlButtonStyle name="LEDSendButton" imDown="Mixer/LEDSendButtonDown.png" imUp="Mixer/LEDSendButtonUp.png" imDisabled="Mixer/LEDSendButtonDisabled.png" optMomentary="false" optDrawText="false" />
    
    <CtrlButtonStyle name="LEDMMixButton" imDown="Mixer/LEDMMixButtonDown.png" imUp="Mixer/LEDMMixButtonUp.png" optMomentary="false" optDrawText="false" />
    <CtrlButtonStyle name="LEDMSendButton" imDown="Mixer/LEDMSendButtonDown.png" imUp="Mixer/LEDMSendButtonUp.png" imDisabled="Mixer/LEDMSendButtonDisabled.png" optMomentary="false" optDrawText="false" />
    <CtrlButtonStyle name="LEDMSetupButton" imDown="Mixer/LEDMSetupButtonDown.png" imUp="Mixer/LEDMSetupButtonUp.png" optMomentary="false" optDrawText="false" />

    <!-- 
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // METERS
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->
    
    <!-- DB reduction meter. VU Meter of this type (moving needle) should be 120px * 55px -->
	<CtrlMeterStyle name="StandardDBReduceMeterStyle" units="dB" unitMarkings="true" leftRangeText="-oo" rightRangeText="0" colUnits="[r:60 g:60 b:60 a:255]" imBackground="Images/Meters/StandardDBVU.png" pivotX="0.5" pivotY="1.10" angleStart="135" angleSize="90" radius="0.90" />
	
	<!-- EQ Graph - Should be 120px * 55px -->
    <CtrlPlotStyle name="EQGraphStyle" imBackground="Images/Meters/EQGraph.png" colBorder="[r:128 g:0 b:128 a:0]" colFill="[r:0 g:0 b:0 a:255]" intSmartTileEdgeSize="5" intRoundedRectRadius="0" lineWidth="2" colLine="[r:0 g:0 b:0 a:255]" plotRectInset="0" />
   

    <!-- 
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // VU METERS
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->

    <CtrlSliderStyle name="VU75Dark"  optHistogram="true" optScaleKnob="true" imBackingStrip="Images/VU/LEDVU75x4DarkOff.png" imAltBackingStrip="Images/VU/LEDVU75x4DarkOn.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" />
    <CtrlSliderStyle name="VU75Light" optHistogram="true" optScaleKnob="true" imBackingStrip="Images/VU/LEDVU75x4LightOff.png" imAltBackingStrip="Images/VU/LEDVU75x4LightOn.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" />
    <CtrlSliderStyle name="VU45Dark"  optHistogram="true" optScaleKnob="true" imBackingStrip="Images/VU/LEDVU45x4DarkOff.png" imAltBackingStrip="Images/VU/LEDVU45x4DarkOn.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" />
    <CtrlSliderStyle name="VU45Light" optHistogram="true" optScaleKnob="true" imBackingStrip="Images/VU/LEDVU45x4LightOff.png" imAltBackingStrip="Images/VU/LEDVU45x4LightOn.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" />
    <CtrlSliderStyle name="VU106"  optHistogram="true" optScaleKnob="true" imBackingStrip="Images/VU/LEDVU106x4Off.png" imAltBackingStrip="Images/VU/LEDVU106x4On.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" />
    <CtrlSliderStyle name="HardVU120" optHistogram="true" optScaleKnob="true" imBackingStrip="Images/VU/HARDVU120x5Off.png" imAltBackingStrip="Images/VU/HARDVU120x5On.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" colSlider="[r:236 g:236 b:236 a:255]" />
    <CtrlSliderStyle name="VU120Horizontal" optHistogram="true" optScaleKnob="true" imBackingStrip="Images/VU/LEDVU120x3Off.png" imAltBackingStrip="Images/VU/LEDVU120x3On.png" snapSteps="0" fineScale="0.05" incDecButtonMode="off" />
    
    <!-- 
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    // CROSS SONG-PANEL STYLES
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->

    <!-- Alternate track highlight styles 1 -->
    <CtrlPanelStyle name="SongTrackPanelStyle0" colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:0 g:0 b:0 a:0]" intSmartTileEdgeSize="5" intRoundedRectRadius="0"></CtrlPanelStyle>
    
    <!-- Alternate track highlight styles 2 -->
    <CtrlPanelStyle name="SongTrackPanelStyle1" colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:255 g:255 b:255 a:50]" intSmartTileEdgeSize="5" intRoundedRectRadius="0"></CtrlPanelStyle>
    
    <!-- Selected track highlight styles -->
    <CtrlPanelStyle name="SongTrackPanelSelectedStyle" colBorder="[r:232 g:204 b:91 a:0]" colFill="[r:232 g:204 b:91 a:80]" intSmartTileEdgeSize="5" intRoundedRectRadius="0"></CtrlPanelStyle>
    
    <!-- Previewing track highlight styles -->
    <CtrlPanelStyle name="SongTrackPanelPreviewingStyle" colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:200 g:0 b:0 a:100]" intSmartTileEdgeSize="5" intRoundedRectRadius="0"></CtrlPanelStyle>
    
    
    
</root>