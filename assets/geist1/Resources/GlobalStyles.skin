	<!-- Default label, black text, centered -->
    <CtrlLabelStyle name="ModalLabelCenteredStyle" colText="[r:18 g:25 b:60 a:255]" centeredText="true">
        <VFont name="font" vSize="12" fontName="Arial" />	
