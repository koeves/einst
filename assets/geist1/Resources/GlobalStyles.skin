    <CtrlTableViewStyle name="GlobalTableStyleAlwaysVisibleHSlider" optVSlider="true" optHSlider="true" optHeader="true" optAltRowColours="true" optColumnDividers="true" optRowDividers="true" colBorder="[r:18 g:25 b:60 a:255]" colFill="[r:0 g:0 b:0 a:0]" colSelect="[r:197 g:151 b:34 a:120]" colRow="[r:169 g:176 b:191 a:80]" colRowAlt="[r:199 g:206 b:217 a:40]" colHeaderBackground="[r:0 g:0 b:0 a:0]" colHeaderSelBackground="[r:148 g:155 b:172 a:175]" colHeaderText="[r:18 g:25 b:60 a:255]" colHeaderDivider="[r:18 g:25 b:60 a:255]" colColumnDivider="[r:18 g:25 b:60 a:255]" colColumnText="[r:18 g:25 b:60 a:255]">
	<VFont name="font" vSize="12" fontName="Arial" />
</CtrlTableViewStyle>

    <!--
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// SCROLLING STYLES
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->
 
    <!-- Scaling scroll bar fader -->
    <CtrlSliderStyle name="VerticalScrollbarStyle" optScaleKnob="true" snapSteps="0" fineScale="0.05" incDecButtonMode="off" colBorder="[r:18 g:25 b:60 a:255]" colSlider="[r:18 g:25 b:60 a:255]" colFill="[r:222 g:229 b:237 a:255]" optIsScrollbar="true" />
    <CtrlSliderStyle name="HorizontalScrollbarStyle" optScaleKnob="true" snapSteps="0" fineScale="0.05" incDecButtonMode="off" colBorder="[r:18 g:25 b:60 a:255]" colSlider="[r:18 g:25 b:60 a:255]" colFill="[r:222 g:229 b:237 a:255]" optIsScrollbar="true" />
    
    <!-- Scroll view style -->
    <CtrlScrollViewStyle name="StandardScrollViewStyle" alwaysShowVSlider="true" alwaysHideHSlider="true" intSmartTileEdgeSize="5" intRoundedRectRadius="0" colBorder="[r:36 g:61 b:88 a:0]" colFill="[r:36 g:61 b:88 a:0]"/>
    <CtrlScrollViewStyle name="EmptyScrollViewStyle" colBorder="[r:0 g:0 b:0 a:0]" colFill="[r:255 g:255 b:255 a:0]" intSmartTileEdgeSize="5" intRoundedRectRadius="0" noDefaultDrawing="true" />

    <!--
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// FADER STYLES
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->
    
    <CtrlSliderStyle name="FieldEditorHistogramStyle" optHistogram="true" optScaleKnob="true" optXFineBehaviour="true" colSlider="[r:255 g:0 b:0 a:180]" colFill="[r:183 g:191 b:199 a:0]" colBorder="[r:0 g:0 b:0 a:0]" fineScale="0.05" incDecButtonMode="off" />
    
    <!-- Small vertical mixer fader style. Sliders of this type should be 20px * 50px -->
    <CtrlSliderStyle name="SmallVerticalFaderStyle" imBackingStrip="Images/Sliders/LEDSmVSliderBack.png" imKnobOff="Images/Sliders/LEDSmVSliderHeadOff.png" imKnobOn="Images/Sliders/LEDSmVSliderHeadOn.png" noDefaultDrawing="true" optFlipDirection="true" optNoClickOutsideKnobMove="true" optNoClickOutsideKnobPage="true"/>
    <CtrlSliderStyle name="FatVerticalFaderStyle" imBackingStrip="Images/Sliders/LEDFatSliderBack.png" imKnobOff="Images/Sliders/LEDFatSliderHeadOff.png" imKnobOn="Images/Sliders/LEDFatSliderHeadOn.png" noDefaultDrawing="true" optFlipDirection="true" optNoClickOutsideKnobMove="true" optNoClickOutsideKnobPage="true"/>

