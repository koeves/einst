    <CtrlTextBoxStyle name="FieldEditorComboBoxStyle" imBackground="Images/EditBoxes/LEDMediumComboBox.png" optSmartTile="false" centeredText="false" optEditable="false" dragable="false" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]" clippingRect="[x:0 y:0 w:52 h:17]">
        <VFont name="font" vSize="12" fontName="Arial" />
    </CtrlTextBoxStyle> 
    
    

	<!-- Value boxes - boxes of this type can be variety of sizes, the background image is tiled to match -->

    <!-- Small value box. Value box of this type should be 50px * 20px -->
    <CtrlTextBoxStyle name="LEDSmallValueBoxStyle" imBackground="Images/EditBoxes/LEDValueBox.png" optSmartTile="true" centeredText="false" optEditable="true" optSendValueWhenFocusLost="true" dragable="false" optSingleClickEdit="true" optAlphaDisabled="true" colBackground="[r:222 g:229 b:237 a:255]" colText="[r:18 g:25 b:60 a:255]">
