    </CtrlLabelStyle>  
    
    <!-- Large, 'notification' label, black text, centered -->
    <CtrlLabelStyle name="StandardLargeLabelCenteredNotificationStyle" colText="[r:18 g:25 b:60 a:255]" centeredText="true">
        <VFont name="font" vSize="32" fontName="Arial" />
    </CtrlLabelStyle>
    
