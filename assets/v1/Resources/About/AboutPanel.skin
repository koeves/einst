        <CtrlLabel name="VersionLabel" style="AboutLabelStyle" rect="[x:2 y:264 w:250 h:15]" id="100004" text="" />
        <CtrlLabel name="DateLabel" style="AboutRightLabel" rect="[x:452 y:264 w:200 h:15]" id="100005" text="" />
